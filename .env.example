# ==============================================================================
# DAREDOWN PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development.
# On Vercel: Add these variables under Project Settings -> Environment Variables.
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# --- APPLICATION & ENVIRONMENT ---
# Port for local development server (ignored on Vercel)
PORT=3000

# Set to "production" on Vercel (automatically set by Vercel) or "development" locally
NODE_ENV=development

# Production application URL (e.g. https://your-tournament.vercel.app)
# Required on Vercel for Google and Discord OAuth redirect URI matching.
APP_URL=https://your-tournament.vercel.app

# --- DATABASE (REQUIRED) ---
# MongoDB Atlas connection string.
# IMPORTANT: Ensure your MongoDB Atlas Network Access allows connections (0.0.0.0/0).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# --- SESSION & COOKIE ENCRYPTION (REQUIRED) ---
# Long random string (at least 32 characters) used to sign session cookies.
SESSION_SECRET=K9vR4wZ7mP2tL8xQ5yB1cJ3nF6sH0aD4

# --- INITIAL ADMINISTRATOR SEEDING (RECOMMENDED) ---
# Upon first database connection, an admin account with these credentials will be seeded.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change_this_to_a_strong_password

# --- GOOGLE OAUTH (OPTIONAL) ---
# Leave empty or set to "mock" to disable Google authentication.
# Google Authorized Redirect URI: https://your-tournament.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- DISCORD OAUTH (OPTIONAL) ---
# Leave empty or set to "mock" to disable Discord authentication.
# Discord Redirect URI: https://your-tournament.vercel.app/api/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
